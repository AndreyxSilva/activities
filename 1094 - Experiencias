#include <stdio.h>
#include <iostream>
#include <iomanip>
 using namespace std;
 
int main() {


    double porcCoelhos;
    double porcRatos;
    double porcSapos;
    int totalCobaias = 0;
    int totalCoelhos = 0;
    int totalRatos = 0;
    int totalSapos = 0;
    int qtdTestes = 0;
    int quantia = 0;
    char tipo;
    
    /* Quantidade de cobaias utilizadas no teste tem que ser
    quantia (1 ≤ quantia ≤ 15) */
    
    cin >> qtdTestes;
    
    for(int i = 0; i < qtdTestes; i++){
        
        cin >> quantia >> tipo;
        
        if (tipo == 'C') {
            totalCoelhos += quantia;
        }
        else if (tipo == 'R') {
            totalRatos += quantia;
        }
        else if (tipo == 'S') {
            totalSapos += quantia;
        }
        
    }

    totalCobaias = totalCoelhos + totalRatos + totalSapos;
    cout << "Total: " << totalCobaias << " cobaias" << endl;
    cout << "Total de coelhos: " << totalCoelhos << endl;
    cout << "Total de ratos: " << totalRatos << endl;
    cout << "Total de sapos: " << totalSapos << endl;
     
    porcCoelhos = (static_cast<double>(totalCoelhos)/static_cast<double>(totalCobaias))*100;
    porcRatos = (static_cast<double>(totalRatos)/static_cast<double>(totalCobaias))*100;
    porcSapos = (static_cast<double>(totalSapos)/static_cast<double>(totalCobaias))*100;

    cout << "Percentual de coelhos: " << fixed << setprecision(2) << porcCoelhos << " %"<< endl;
    cout << "Percentual de ratos: " << fixed << setprecision(2) <<porcRatos << " %" << endl;
    cout << "Percentual de sapos: " << fixed << setprecision(2) << porcSapos << " %" << endl;
    
 
    return 0;
}
