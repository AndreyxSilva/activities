#include <stdio.h>
#include <iostream>

using namespace std;

void tabuada(int X){
    
    int resultado = 0;
    
    for(int i = 1; i <= 10; i++){
        resultado = i*X;
        cout << i << " x " << X << " = " << resultado << endl; 
        
    }
}
 
int main() {
 
    int N;
    
    cin >> N;
    tabuada(N);
    
    return 0;
}
